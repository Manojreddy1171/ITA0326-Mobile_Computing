# Root Environment Configuration Template
# Copy this to backend/.env

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=wholesalehub

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_wholesalehub_production
JWT_EXPIRES_IN=7d

# File Uploads (Local disk fallback, modular for S3)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Frontend URL (CORS allowed origin)
FRONTEND_URL=http://localhost:5173
